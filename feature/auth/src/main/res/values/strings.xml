<resources>
    <!-- Marca, usada na abertura e na barra superior do fluxo de entrada -->
    <string name="auth_app_name">Run &amp; Lift</string>
    <string name="auth_back">Voltar</string>

    <!-- Boas-vindas: escolha de papel antes do login -->
    <string name="welcome_slogan">Do plano à última repetição, no mesmo lugar.</string>
    <!-- Afirmativa, e não pergunta: a tela não está consultando, está conduzindo para as duas
         saídas logo abaixo. -->
    <string name="welcome_prompt">Escolha o seu perfil para começar</string>
    <string name="welcome_reversible">Você poderá alterar o seu perfil depois.</string>

    <!-- Etiqueta do perfil em que a pessoa está. Só o substantivo: o chip é indicador de
         contexto, não uma frase. -->
    <string name="auth_role_student">Aluno</string>
    <string name="auth_role_trainer">Treinador</string>

    <!-- Entrada. Títulos neutros: quem carrega o perfil é o chip, não a manchete. -->
    <string name="auth_sign_in_title">Entre na sua conta</string>
    <string name="auth_sign_in_subtitle">Use o e-mail e a senha cadastrados.</string>
    <string name="auth_sign_up_title">Crie a sua conta</string>
    <string name="auth_sign_up_subtitle">Leva menos de um minuto.</string>
    <!-- O subtítulo do cadastro confirma o perfil escolhido na abertura sem gastar uma tela
         inteira perguntando de novo. -->
    <string name="auth_sign_up_subtitle_student">Você recebe os treinos do seu treinador e registra
        as suas séries, com ou sem internet na academia.</string>
    <string name="auth_sign_up_subtitle_trainer">Você monta os treinos e acompanha a evolução de
        cada aluno num lugar só.</string>

    <string name="auth_email">E-mail</string>
    <string name="auth_password">Senha</string>
    <!-- Descrições do alternador de visibilidade: viraram conteúdo de acessibilidade quando o
         controle passou de texto para ícone. -->
    <string name="auth_password_show">Mostrar senha</string>
    <string name="auth_password_hide">Ocultar senha</string>
    <!-- Dito na entrada do campo, antes de a pessoa errar: regra anunciada vale mais que erro
         explicado. Plural pelo mesmo motivo do erro correspondente. -->
    <plurals name="auth_password_min_length">
        <item quantity="one">Mínimo de %1$d caractere.</item>
        <item quantity="other">Mínimo de %1$d caracteres.</item>
    </plurals>
    <string name="auth_sign_in_action">Entrar</string>
    <string name="auth_sign_up_action">Criar conta</string>
    <string name="auth_forgot_password">Esqueci minha senha</string>
    <string name="auth_or">ou</string>

    <!-- Caminho alternativo. Pergunta e resposta formam UM botão de texto só — é a única porta
         para o cadastro, e alvo dividido aqui é caminho perdido. A resposta está no imperativo
         ("Crie uma conta") porque é o que a pessoa manda o app fazer, não o nome de uma tela. -->
    <string name="auth_prompt_no_account">Ainda não tem conta?</string>
    <string name="auth_prompt_has_account">Já tem uma conta?</string>
    <!-- Saída da recuperação de senha. Mesmo desenho das outras duas: a seta de voltar é um alvo
         pequeno no topo, e quem desiste está olhando para o fim da tela. -->
    <string name="auth_prompt_remembered_password">Lembrou a senha?</string>
    <string name="auth_go_to_sign_up">Crie uma conta</string>
    <string name="auth_go_to_sign_in">Entrar</string>

    <!-- Aviso legal da entrada federada: a folha do Google cria conta, e criar conta exige dizer
         a que se está concordando. Os documentos ficam a um toque, logo abaixo. -->
    <string name="auth_legal_notice_sign_in">Ao continuar, você concorda com os Termos de Uso e a
        Política de Privacidade.</string>

    <!-- Cadastro: identidade -->
    <string name="auth_name">Nome completo</string>
    <string name="auth_name_support_student">É assim que o seu treinador vai te encontrar na lista
        de alunos.</string>
    <string name="auth_name_support_trainer">É o nome que os seus alunos veem no app.</string>
    <string name="auth_birth_date">Data de nascimento</string>
    <!-- A finalidade é dita no próprio campo, e não numa política que ninguém abre: é o que a LGPD
         chama de informação adequada sobre o tratamento (art. 9º). -->
    <string name="auth_birth_date_support_student">Ajusta as faixas de esforço do seu treino.</string>
    <string name="auth_birth_date_support_trainer">Confirma que você tem idade para criar
        a conta.</string>
    <string name="auth_phone">Celular (WhatsApp)</string>
    <string name="auth_phone_support_student">Opcional. Seu treinador usa para falar com você fora
        do app.</string>
    <!-- Sem "Opcional": para o treinador este campo é obrigatório. O aluno tem com quem falar
         dentro do app assim que o vínculo existe; o treinador é o canal, e o número dele é o que o
         aluno procura antes de existir vínculo nenhum. -->
    <string name="auth_phone_support_trainer">Seus alunos usam para falar com você fora do
        app.</string>

    <!-- Cadastro: localidade. Os dois campos abrem uma lista em vez de aceitarem digitação, e a
         linha de apoio diz para que serve a resposta — mesma regra dos outros campos. -->
    <string name="auth_state">Estado</string>
    <string name="auth_state_support">Escolha o seu estado na lista.</string>
    <string name="auth_city">Cidade</string>
    <string name="auth_city_support">É por ela que aluno e treinador se encontram perto.</string>
    <!-- Substitui a linha de apoio enquanto não há estado. Diz o que falta em vez de deixar um
         campo cinza sem explicação, que é o que vira mensagem de suporte. -->
    <string name="auth_city_needs_state">Escolha o estado primeiro.</string>

    <!-- Telas de seleção. Título é o substantivo do que se escolhe: a tela inteira já é a pergunta,
         e "Escolha o seu estado" no topo repetiria o que a lista abaixo está dizendo. -->
    <string name="auth_state_picker_title">Estado</string>
    <string name="auth_state_picker_search">Buscar estado</string>
    <string name="auth_state_picker_empty">Nenhum estado com esse nome.</string>
    <string name="auth_city_picker_title">Cidade</string>
    <string name="auth_city_picker_search">Buscar cidade</string>
    <string name="auth_city_picker_empty">Nenhuma cidade com esse nome neste estado.</string>
    <string name="auth_picker_clear">Limpar busca</string>
    <!-- A lista vem do IBGE, e por isso depende de rede. A frase não culpa o aparelho nem o
         servidor: diz o que aconteceu e oferece o botão, que é a única coisa acionável. -->
    <string name="auth_picker_failure">Não deu para carregar a lista agora. Confira sua conexão.</string>
    <string name="auth_picker_retry">Tentar de novo</string>

    <!-- Minimização de dados dita em voz alta: o que o cadastro NÃO pede tranquiliza tanto quanto
         o que ele explica. -->
    <string name="auth_health_notice">Peso, medidas e histórico de lesões não são pedidos aqui.
        Esses dados vêm depois, na avaliação com o seu treinador, e só com a sua autorização.</string>

    <!-- Cadastro: registro profissional, só do treinador -->
    <string name="auth_cref">Registro no CREF</string>
    <string name="auth_cref_support">Como está na sua carteira. Exemplo: 012345-G/SP.</string>
    <!-- Contraparte do aviso do aluno: lá o app diz o que NÃO pede, aqui diz o que vai FAZER com o
         que pediu. Nos dois casos, responder antes de a pergunta ser feita. -->
    <string name="auth_cref_notice">Prescrever treino é atividade privativa de profissional
        registrado (Lei 9.696/1998). Seu número fica visível para os alunos vinculados a você e
        pode ser conferido no CONFEF.</string>

    <!-- Consentimento (LGPD art. 8º). Duas caixas separadas, as duas desmarcadas: aceite em bloco
         não é consentimento, e caixa pré-marcada não é escolha. -->
    <string name="auth_terms_accept">Li e concordo com os Termos de Uso e a Política de
        Privacidade.</string>
    <string name="auth_terms_required">Para criar a conta é preciso aceitar os Termos de Uso e a
        Política de Privacidade.</string>
    <string name="auth_terms_open">Termos de Uso</string>
    <string name="auth_privacy_open">Política de Privacidade</string>
    <string name="auth_marketing_opt_in">Quero receber dicas de treino e novidades por e-mail.</string>
    <string name="auth_marketing_support">Opcional, e você pode cancelar quando quiser.</string>

    <!-- Endereços dos documentos. Provisórios: o domínio existe, as páginas ainda não. -->
    <string name="auth_terms_url" translatable="false">https://runandlift.app/termos</string>
    <string name="auth_privacy_url" translatable="false">https://runandlift.app/privacidade</string>

    <!-- Conclusão de cadastro depois da entrada por Google. Diz de quem é a lacuna sem culpar
         ninguém: o provedor informa o que informa, e o resto quem sabe é a pessoa. -->
    <string name="auth_complete_title">Falta pouco</string>
    <string name="auth_complete_subtitle">O Google informa nome e e-mail. O resto quem precisa
        dizer é você.</string>
    <string name="auth_complete_subtitle_named">Olá, %1$s. O Google informa nome e e-mail — o resto
        quem precisa dizer é você.</string>
    <string name="auth_complete_action">Concluir cadastro</string>

    <!-- Recuperação de senha -->
    <string name="auth_recovery_title">Recuperar senha</string>
    <string name="auth_recovery_explanation">Informe o e-mail da sua conta. Se ele estiver
        cadastrado, você recebe um link para criar uma senha nova.</string>
    <string name="auth_recovery_action">Enviar link</string>
    <!-- Ambígua de propósito: aparece igual para endereço que existe e para endereço que não
         existe. Distinguir os dois casos transformaria a tela num verificador de quem tem conta. -->
    <string name="auth_recovery_sent">Se o e-mail estiver cadastrado, o link já está a caminho.
        Confira também a caixa de spam.</string>

    <!-- Validação de formulário -->
    <string name="auth_error_email_required">Informe seu e-mail.</string>
    <string name="auth_error_email_invalid">Esse e-mail não parece válido.</string>
    <string name="auth_error_password_required">Informe sua senha.</string>
    <!-- Plural, e não string com %d: o dia em que o mínimo for 1, "1 caracteres" apareceria. -->
    <plurals name="auth_error_password_too_short">
        <item quantity="one">A senha precisa de pelo menos %1$d caractere.</item>
        <item quantity="other">A senha precisa de pelo menos %1$d caracteres.</item>
    </plurals>
    <string name="auth_error_name_required">Informe o seu nome.</string>
    <string name="auth_error_name_incomplete">Informe nome e sobrenome.</string>
    <string name="auth_error_birth_date_required">Informe a sua data de nascimento.</string>
    <!-- "Incompleta" e "não existe" são erros diferentes: quem está no meio da digitação não
         merece ouvir que errou. -->
    <string name="auth_error_birth_date_incomplete">Complete a data no formato DD/MM/AAAA.</string>
    <string name="auth_error_birth_date_invalid">Essa data não existe. Confira o dia, o mês e o
        ano.</string>
    <!-- Diz a regra e, principalmente, por onde o menor de idade entra — barreira sem saída é
         porta na cara. -->
    <plurals name="auth_error_birth_date_too_young">
        <item quantity="one">É preciso ter %1$d ano para criar conta. Menores de idade são
            cadastrados pelo treinador, com o responsável.</item>
        <item quantity="other">É preciso ter %1$d anos para criar conta. Menores de idade são
            cadastrados pelo treinador, com o responsável.</item>
    </plurals>
    <string name="auth_error_phone_invalid">Informe DDD e número, com 10 ou 11 dígitos.</string>
    <string name="auth_error_phone_required">Informe o seu celular com DDD.</string>
    <!-- Localidade não se digita, então o erro manda escolher e não conferir: "estado inválido"
         seria acusar a pessoa de um valor que quem ofereceu foi o app. -->
    <string name="auth_error_state_required">Escolha o seu estado.</string>
    <string name="auth_error_city_required">Escolha a sua cidade.</string>
    <string name="auth_error_cref_required">Informe o seu registro no CREF.</string>
    <!-- Aponta as três partes e repete o exemplo: "inválido" sozinho deixa a pessoa adivinhando
         qual delas errou. -->
    <string name="auth_error_cref_invalid">Confira o número, a categoria e a sigla do estado.
        Exemplo: 012345-G/SP.</string>
    <!-- Diz quais letras servem em vez de só recusar: quem digitou E ou outra categoria acertou o
         número e a sigla, e mandá-lo "conferir o registro" o faz procurar erro onde não há. -->
    <string name="auth_error_cref_category">A categoria do CREF deve ser G (graduado) ou P
        (provisionado).</string>

    <!-- Falhas vindas do servidor -->
    <string name="auth_error_invalid_credentials">E-mail ou senha incorretos.</string>
    <string name="auth_error_email_in_use">Já existe uma conta com esse e-mail.</string>
    <string name="auth_error_weak_password">Escolha uma senha mais forte.</string>
    <string name="auth_error_no_network">Sem conexão. Verifique a internet e tente de novo.</string>
    <string name="auth_error_too_many_attempts">Muitas tentativas. Aguarde alguns minutos.</string>
    <string name="auth_error_unknown">Não foi possível concluir. Tente de novo.</string>
    <string name="auth_error_no_google_account">Nenhuma conta Google disponível neste aparelho.
        Adicione uma nas configurações do Android e tente de novo.</string>

    <!-- Entrar com Google -->
    <string name="auth_google_action">Entrar com Google</string>

    <!-- Escolha de papel -->
    <string name="onboarding_title">Como você vai usar o Run &amp; Lift?</string>
    <string name="onboarding_explanation">Dá para mudar depois, e dá para ser os dois.</string>
    <string name="onboarding_student">Sou aluno</string>
    <string name="onboarding_student_description">Recebo treinos e registro minhas séries.</string>
    <string name="onboarding_trainer">Sou treinador</string>
    <string name="onboarding_trainer_description">Prescrevo treinos e acompanho meus alunos.</string>
    <string name="onboarding_confirm">Continuar</string>
</resources>
