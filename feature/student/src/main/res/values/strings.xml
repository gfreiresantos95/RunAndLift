<resources>
    <!--
        O nome do app aparece aqui, e não vem de :app, porque módulo de feature não enxerga o
        aplicativo — é a mesma direção de dependência que mantém :feature:auth independente. São
        duas cópias da mesma palavra, e é o preço de a seta apontar para um lado só.
    -->
    <string name="student_app_name">Run &amp; Lift</string>

    <!-- Abas da barra inferior. -->
    <string name="student_tab_home">Início</string>
    <string name="student_tab_workouts">Treinos</string>
    <string name="student_tab_menu">Menu</string>

    <!-- Início. -->
    <string name="student_home_greeting">Olá, %1$s</string>
    <!-- Sem nome gravado: conta criada pelo Google que ainda não completou o cadastro. -->
    <string name="student_home_greeting_anonymous">Olá!</string>
    <!-- Só aparece para quem ainda não se vinculou a ninguém: com treinador, a linha é a de baixo,
         que diz algo que a pessoa não sabia. -->
    <string name="student_home_role">Aluno</string>
    <!-- O CREF vem escrito por extenso porque "012345-G/SP" sozinho não se lê como um registro
         profissional — e é justamente por ser conferível no CONFEF que ele está na tela. -->
    <string name="student_home_trainer">Treinador: %1$s · CREF %2$s</string>
    <string name="student_home_trainer_since">Aluno desde %1$s</string>

    <!-- Aviso de perfil incompleto. Diz quantas faltam para a pessoa decidir se agora é hora. -->
    <plurals name="student_home_reminder_title">
        <item quantity="one">Falta %1$d resposta no seu perfil</item>
        <item quantity="other">Faltam %1$d respostas no seu perfil</item>
    </plurals>
    <string name="student_home_reminder_body">Quanto mais o seu treinador souber sobre você, mais o
        treino é seu. Toque para completar.</string>


    <!-- Painel da home. -->

    <!-- Próximo treino: a pergunta com que se abre o app dentro da academia. O título mora dentro
         do card, e não acima dele: é o card inteiro que responde à pergunta, e um título solto
         acima gastava uma linha para anunciar o que vinha na seguinte. -->
    <string name="student_home_next_workout_title">Seu próximo treino</string>
    <string name="student_home_next_workout_when">Hoje</string>
    <!-- O quando entrou aqui quando o título tomou o lugar dele: "hoje" continua sendo a metade da
         resposta, mas cabe junto do tamanho do treino em vez de ocupar uma linha inteira. -->
    <string name="student_home_next_workout_meta">%1$s · %2$s</string>
    <plurals name="student_home_next_workout_size">
        <item quantity="one">%1$d exercício · cerca de %2$d min</item>
        <item quantity="other">%1$d exercícios · cerca de %2$d min</item>
    </plurals>

    <!-- A semana: constância se enxerga em faixa, e não em número. -->
    <string name="student_home_week_title">Sua semana</string>
    <!-- Ditas pelo leitor de tela no lugar da marca do dia, com o nome do dia por extenso. -->
    <string name="student_home_week_day_done">%1$s, treino feito</string>
    <string name="student_home_week_day_planned">%1$s, treino previsto</string>
    <string name="student_home_week_day_rest">%1$s, descanso</string>

    <string name="student_home_sessions_value">%1$d de %2$d</string>
    <string name="student_home_sessions_label">Treinos da semana</string>
    <plurals name="student_home_sessions_remaining">
        <item quantity="one">Falta %1$d para fechar</item>
        <item quantity="other">Faltam %1$d para fechar</item>
    </plurals>
    <!-- O recibo de quem cumpriu. Sem ele a peça diria "faltam 0 treinos". -->
    <string name="student_home_sessions_complete">Semana completa</string>

    <plurals name="student_home_streak_label">
        <item quantity="one">Semana seguida</item>
        <item quantity="other">Semanas seguidas</item>
    </plurals>
    <string name="student_home_streak_support">Sem furar desde 14/07</string>

    <string name="student_home_volume_value">%1$s kg</string>
    <string name="student_home_volume_label">Volume</string>
    <string name="student_home_volume_support">Carga total levantada</string>

    <string name="student_home_time_label">Tempo em treino</string>
    <string name="student_home_time_support">Somando as sessões da semana</string>

    <!-- Recorde: a peça que é boa de ver e não pede nada, e por isso fica por último. -->
    <string name="student_home_record_title">Seu recorde mais recente</string>
    <!-- Treinos. -->
    <string name="student_workouts_title">Treinos</string>
    <!-- Título do vazio no presente, e não "nenhum treino": ele descreve o que a tela É, e a linha
         de baixo diz o que falta acontecer — que aqui é coisa de outra pessoa, e dizer isso evita
         que a pessoa fique procurando o passo que ela teria esquecido. -->
    <string name="student_workouts_empty_title">Seus treinos aparecem aqui</string>
    <string name="student_workouts_empty">Assim que seu treinador montar o primeiro, ele chega nesta
        aba — e fica disponível mesmo sem internet na academia.</string>

    <!-- Menu. Duas linhas de perfil porque são dois documentos com dois públicos: "Meus dados" só o
         titular lê, "Perfil de treino" o treinador vinculado também. -->
    <string name="student_menu_title">Menu</string>
    <string name="student_menu_section_profile">Perfil</string>
    <string name="student_menu_section_account">Conta</string>
    <string name="student_menu_account">Meus dados</string>
    <string name="student_menu_account_description">Nome, contato e como você entra no app.</string>
    <string name="student_menu_training">Perfil de treino</string>
    <string name="student_menu_training_description">Nível, objetivo, dias e o que o seu treinador
        precisa saber para montar seu treino.</string>
    <string name="student_menu_trainer">Meu treinador</string>
    <string name="student_menu_trainer_description">Quem acompanha seus treinos, ou o código para
        entrar com alguém.</string>
    <string name="student_menu_sign_out">Sair da conta</string>
    <string name="student_menu_switch_role">Trocar de papel</string>

    <string name="student_action_back">Voltar</string>
    <string name="student_action_save">Salvar</string>
    <string name="student_save_failed">Não deu para salvar agora. Confira sua conexão e tente de
        novo.</string>
    <!-- Confirmação de salvamento. No passado e sem exclamação: é um recibo, não uma comemoração —
         a pessoa corrigiu um telefone, não bateu um recorde. -->
    <string name="student_saved">Alterações salvas.</string>
    <!-- Anunciado pelo leitor de tela quando o indicador de carregamento entra. Sem isto, quem usa
         TalkBack não recebe sinal nenhum de que algo está em curso. -->
    <string name="student_loading">Carregando</string>

    <!-- Meus dados. -->
    <string name="student_account_title">Meus dados</string>
    <string name="student_field_name">Nome completo</string>
    <string name="student_field_name_support">É assim que o seu treinador te encontra na lista de
        alunos.</string>
    <string name="student_field_phone">Celular (WhatsApp)</string>
    <string name="student_field_phone_support">Opcional. Ajuda o seu treinador a falar com você
        fora do app.</string>
    <string name="student_field_birth_date">Data de nascimento</string>
    <string name="student_field_birth_date_support">Ajusta as faixas de esforço do seu treino, e por
        isso não muda por aqui.</string>

    <!-- Localidade. Os dois campos abrem uma lista em vez de aceitarem digitação. -->
    <string name="student_field_state">Estado</string>
    <string name="student_field_state_support">Escolha o seu estado na lista.</string>
    <string name="student_field_city">Cidade</string>
    <string name="student_field_city_support">É por ela que você e o seu treinador se encontram
        perto.</string>
    <!-- Substitui a linha de apoio enquanto não há estado: campo cinza sem explicação parece
         defeito, e a dúvida que ele levanta é a que vira mensagem de suporte. -->
    <string name="student_field_city_needs_state">Escolha o estado primeiro.</string>

    <!-- Telas de seleção. Título é o substantivo do que se escolhe: a tela inteira já é a pergunta. -->
    <string name="student_state_picker_title">Estado</string>
    <string name="student_state_picker_search">Buscar estado</string>
    <string name="student_state_picker_empty">Nenhum estado com esse nome.</string>
    <string name="student_city_picker_title">Cidade</string>
    <string name="student_city_picker_search">Buscar cidade</string>
    <string name="student_city_picker_empty">Nenhuma cidade com esse nome neste estado.</string>
    <string name="student_picker_clear">Limpar busca</string>
    <!-- A lista vem do IBGE, e por isso depende de rede. A frase diz o que aconteceu e oferece o
         botão, que é a única coisa acionável. -->
    <string name="student_picker_failure">Não deu para carregar a lista agora. Confira sua
        conexão.</string>
    <string name="student_picker_retry">Tentar de novo</string>

    <!-- Erros dos dados cadastrais. -->
    <string name="student_error_name_required">Informe o seu nome.</string>
    <string name="student_error_name_incomplete">Informe nome e sobrenome.</string>
    <string name="student_error_phone_invalid">Informe DDD e número, com 10 ou 11 dígitos.</string>
    <!-- Localidade não se digita, então o erro manda escolher e não conferir: "estado inválido"
         seria acusar a pessoa de um valor que quem ofereceu foi o app. -->
    <string name="student_error_state_required">Escolha o seu estado.</string>
    <string name="student_error_city_required">Escolha a sua cidade.</string>

    <!-- Onboarding: cabeçalho e navegação. -->
    <string name="student_onboarding_progress">Passo %1$d de %2$d</string>
    <string name="student_onboarding_next">Continuar</string>
    <string name="student_onboarding_finish">Concluir</string>
    <string name="student_onboarding_skip">Pular por agora</string>
    <string name="student_onboarding_save_failed">Não deu para salvar agora. Você pode tentar de
        novo, ou seguir e completar depois pelo seu perfil.</string>

    <!-- Onboarding: títulos em segunda pessoa, porque é uma conversa. A linha de apoio diz sempre
         para que a resposta serve — é o que faz a pessoa responder em vez de pular. -->
    <string name="student_onboarding_level_title">Como está o seu treino hoje?</string>
    <!-- O primeiro passo carrega a promessa do fluxo inteiro: é curto, e nada aqui é definitivo.
         Sem isso, quem acabou de criar a conta lê seis perguntas como um segundo cadastro. -->
    <string name="student_onboarding_level_subtitle">Isso decide por onde o seu treinador começa.
        Leva menos de um minuto, e você pode mudar tudo depois no seu perfil.</string>
    <string name="student_onboarding_goal_title">Qual é o seu objetivo?</string>
    <string name="student_onboarding_goal_subtitle">A mesma pessoa treina diferente para cada um
        deles. Escolha o principal.</string>
    <string name="student_onboarding_days_title">Em quais dias você pode treinar?</string>
    <string name="student_onboarding_days_subtitle">O programa é montado em cima da sua agenda, e
        não do contrário.</string>
    <string name="student_onboarding_health_title">Podemos guardar seus dados de saúde?</string>
    <string name="student_onboarding_health_subtitle">Peso, altura e histórico de lesão só são
        guardados com a sua autorização.</string>
    <string name="student_onboarding_measures_title">Peso e altura</string>
    <string name="student_onboarding_measures_subtitle">São o ponto de partida. A avaliação com o
        seu treinador é que confere.</string>
    <string name="student_onboarding_injuries_title">Alguma lesão ou limitação?</string>
    <!-- Diz que é para marcar, e que marcar nada também é resposta: um campo em branco fazia metade
         das pessoas pular sem saber o que era esperado delas. -->
    <string name="student_onboarding_injuries_subtitle">Marque as regiões que te incomodam. É o que
        evita um exercício que te machuque — e se não houver nenhuma, diga isso também.</string>

    <!-- Onboarding: dias. -->
    <string name="student_onboarding_days_none">Nenhum dia escolhido ainda.</string>
    <plurals name="student_onboarding_days_count">
        <item quantity="one">%1$d dia por semana</item>
        <item quantity="other">%1$d dias por semana</item>
    </plurals>

    <!-- Consentimento de dado de saúde. O aviso vem antes da caixa: primeiro o que será guardado,
         para quê e quem vê; só então a pergunta. -->
    <string name="student_onboarding_health_notice">Peso, altura e histórico de lesão são dados de
        saúde. Servem para o seu treinador ajustar o que prescreve, e só ele — com vínculo ativo com
        você — pode lê-los. Você pode responder depois, ou não responder.</string>
    <string name="student_onboarding_health_consent">Autorizo guardar meus dados de saúde para
        ajustar o meu treino.</string>

    <!-- Níveis. -->
    <string name="student_level_beginner">Iniciante</string>
    <string name="student_level_beginner_description">Nunca treinei, ou parei há tanto tempo que
        volto do começo.</string>
    <string name="student_level_intermediate">Intermediário</string>
    <string name="student_level_intermediate_description">Treino com alguma regularidade e conheço
        os movimentos principais.</string>
    <string name="student_level_advanced">Avançado</string>
    <string name="student_level_advanced_description">Treino há anos, sem parar por muito tempo, e
        acompanho minhas cargas.</string>

    <!-- Objetivos. -->
    <string name="student_goal_hypertrophy">Ganhar massa muscular</string>
    <string name="student_goal_strength">Ficar mais forte</string>
    <string name="student_goal_weight_loss">Perder gordura</string>
    <string name="student_goal_conditioning">Ganhar fôlego e resistência</string>
    <string name="student_goal_health">Saúde e disposição</string>

    <!-- Dias da semana. Abreviados na tela, por extenso para o leitor de tela. -->
    <string name="student_day_monday">Seg</string>
    <string name="student_day_tuesday">Ter</string>
    <string name="student_day_wednesday">Qua</string>
    <string name="student_day_thursday">Qui</string>
    <string name="student_day_friday">Sex</string>
    <string name="student_day_saturday">Sáb</string>
    <string name="student_day_sunday">Dom</string>
    <string name="student_day_monday_full">Segunda-feira</string>
    <string name="student_day_tuesday_full">Terça-feira</string>
    <string name="student_day_wednesday_full">Quarta-feira</string>
    <string name="student_day_thursday_full">Quinta-feira</string>
    <string name="student_day_friday_full">Sexta-feira</string>
    <string name="student_day_saturday_full">Sábado</string>
    <string name="student_day_sunday_full">Domingo</string>

    <!-- Campos. -->
    <string name="student_field_weight">Peso (kg)</string>
    <string name="student_field_weight_support">Ponto de partida para acompanhar sua evolução.</string>
    <string name="student_field_height">Altura (cm)</string>
    <string name="student_field_height_support">Em centímetros. Exemplo: 175.</string>
    <!-- Regiões do corpo, na ordem da cabeça aos pés. Os termos são os da anamnese, e não
         paráfrases populares: são os que a pessoa já ouviu no consultório e os que o treinador vai
         reler ao lado do que o médico escreveu. -->
    <string name="student_injury_neck">Pescoço</string>
    <string name="student_injury_shoulder">Ombro</string>
    <string name="student_injury_elbow">Cotovelo</string>
    <string name="student_injury_wrist_hand">Punho ou mão</string>
    <string name="student_injury_upper_back">Coluna torácica</string>
    <string name="student_injury_lower_back">Coluna lombar</string>
    <string name="student_injury_hip">Quadril</string>
    <string name="student_injury_knee">Joelho</string>
    <string name="student_injury_ankle_foot">Tornozelo ou pé</string>
    <!-- "Nenhuma" é resposta, e não ausência dela: sem ela, quem não tem lesão carregaria o aviso
         de perfil incompleto para sempre. -->
    <string name="student_injury_none">Nenhuma</string>
    <string name="student_injury_other">Outra</string>

    <!-- O texto livre que a lista não substitui: a região diz onde, isto diz o quê e quando. -->
    <string name="student_field_injury_notes">Conte um pouco mais</string>
    <string name="student_field_injury_notes_support">Ex.: dói o ombro direito quando levanto acima
        da cabeça.</string>
    <string name="student_field_injury_notes_sample">Dói o ombro direito quando levanto acima da
        cabeça.</string>
    <string name="student_field_email">E-mail</string>
    <string name="student_field_email_support">É como você entra no app, e por isso não muda por
        aqui.</string>

    <!-- Erros dos campos digitados. As frases falam de conferir o número, nunca do valor: quem
         digitou 7 no lugar de 70 precisa do aviso, quem pesa 140 não precisa de opinião. -->
    <string name="student_error_weight_invalid">Confira o peso em quilos. Exemplo: 72,5.</string>
    <string name="student_error_height_invalid">Confira a altura em centímetros. Exemplo: 175.</string>

    <!-- Edição de perfil. -->
    <string name="student_profile_title">Perfil de treino</string>

    <!-- Meu treinador. -->
    <string name="student_trainer_title">Meu treinador</string>
    <string name="student_trainer_back">Voltar para o menu</string>
    <string name="student_trainer_loading">Carregando seu treinador</string>
    <string name="student_trainer_failed">Não foi possível carregar agora.</string>
    <string name="student_trainer_unnamed">Treinador sem nome no cadastro</string>
    <!-- Diz o que o código faz e o que ele não faz: quem entende que ainda vai ser aceito não fica
         esperando treino aparecer na mesma hora. -->
    <string name="student_trainer_explanation">Peça o código de convite ao seu treinador e digite
        aqui. Ele ainda precisa aceitar o seu pedido.</string>
    <string name="student_trainer_code">Código de convite</string>
    <string name="student_trainer_code_support">Seis caracteres, como ABC234.</string>
    <string name="student_trainer_search">Continuar</string>
    <!-- A confirmação pergunta em vez de afirmar: o nome foi escrito por quem gerou o código, e
         não é identidade verificada. -->
    <string name="student_trainer_confirm_explanation">Este é o treinador do código. Ao continuar,
        ele poderá ver seu perfil de treino, incluindo peso, altura e lesões.</string>
    <string name="student_trainer_confirm">Pedir para treinar com ele</string>
    <string name="student_trainer_dismiss">Não é ele</string>
    <string name="student_trainer_accept">Aceitar convite</string>
    <string name="student_trainer_cancel">Cancelar pedido</string>
    <string name="student_trainer_end">Encerrar</string>
    <string name="student_trainer_past">Treinadores anteriores</string>

    <!-- Estado do vínculo, dito do lado do aluno: o mesmo estado tem outra frase para o treinador. -->
    <string name="student_link_invited">Convidou você para treinar.</string>
    <string name="student_link_requested">Aguardando a resposta dele.</string>
    <string name="student_link_active">Acompanha seus treinos</string>
    <string name="student_link_paused">Pausado</string>
    <string name="student_link_ended">Encerrado</string>

    <!-- Erros do código. Cada frase diz o que fazer, e três delas não são "tente de novo". -->
    <string name="student_trainer_error_not_found">Não encontramos esse código. Confira as letras e
        os números com quem enviou.</string>
    <string name="student_trainer_error_own_code">Esse código é o seu, do seu perfil de treinador.</string>
    <string name="student_trainer_error_already_linked">Você já tem um vínculo com esse
        treinador.</string>
    <string name="student_trainer_error_unknown">Não foi possível concluir agora. Confira sua
        conexão e tente de novo.</string>
</resources>
