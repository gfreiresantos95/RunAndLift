# IDE — ignora tudo em .idea, exceto o que é compartilhável
.idea/*
!.idea/.gitignore
!.idea/codeStyles/
!.idea/inspectionProfiles/
!.idea/compiler.xml
# Atenção à caixa: o arquivo em disco é AndroidProjectSystem.xml. Em Windows a diferença passa
# batida, mas em Linux e macOS a exceção com caixa errada não casa e o arquivo some do repositório.
!.idea/AndroidProjectSystem.xml
!.idea/vcs.xml
!.idea/runConfigurations.xml

# Android / Gradle
*.iml
.gradle/
# Saída do compilador Kotlin 2.x: .kotlin/sessions durante o build e .kotlin/errors quando a
# compilação falha. Fica fora de build/, então precisa de regra própria.
.kotlin/
local.properties
/build
*/build/
/captures
.externalNativeBuild
.cxx

# Firebase e assinatura — nunca vão para o Git, porque o repositório é público.
# O google-services.json carrega project_id e API key; enquanto o App Check (E0-07) não existir,
# expor isso permite consumir a cota gratuita do Firestore, de que depende todo o modelo de
# capacidade do projeto. Como obtê-lo: README, seção Firebase.
google-services.json
*.jks
*.keystore
keystore.properties
secrets.properties

# Node e Firebase CLI — usados só pelos testes das Security Rules (firestore/)
node_modules/
# Cache local do CLI, criado no primeiro `firebase deploy`.
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# Claude Code — settings.json é versionado de propósito: é o allowlist de comandos do projeto,
# citado no CLAUDE.md, e não guarda segredo nenhum. O settings.local.json é o arquivo pessoal de
# cada máquina, que o próprio Claude Code escreve ao aprovar um comando pontual.
.claude/settings.local.json

# SO
.DS_Store
