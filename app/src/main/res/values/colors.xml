<?xml version="1.0" encoding="utf-8"?>
<!--
    Cores em XML existem apenas para o que roda ANTES do Compose: a splash e o fundo da janela.
    As cores da UI ficam em ui/theme/Color.kt. Ao mudar a marca, os dois lados precisam andar
    juntos, senão a splash pisca numa cor que o app não usa mais.

    window_background acompanha `surface` do tema claro (Neutro98) para que a transição da splash
    para a primeira tela não tenha flash de cor.
-->
<resources>
    <color name="window_background">#FBF8FF</color>
    <!-- Círculo atrás do ícone da splash: Cobalto40. Necessário porque o ícone atual é branco e
         desapareceria sobre a superfície clara. -->
    <color name="splash_icon_background">#2A56B4</color>
</resources>
